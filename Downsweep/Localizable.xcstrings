        }
      }
    },
    "Downsweep tidied %@ and freed %@. Click to see and share your week.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Downsweep tidied %1$@ and freed %2$@. Click to see and share your week."
